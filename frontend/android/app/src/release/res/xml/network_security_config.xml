<?xml version="1.0" encoding="utf-8"?>
<!-- Public release: HTTPS with system trust anchors only. The private-server
     compatibility mode in src/main is intentionally limited to beta/debug APKs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
